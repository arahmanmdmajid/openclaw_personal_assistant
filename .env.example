# Hermes Personal Assistant - Environment Variables
# Copy this file to .env and fill in your values

# ── Anthropic (Claude) ─────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Telegram Bot ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_IDS=123456789   # comma-separated user IDs allowed to use the bot

# ── GitHub API ─────────────────────────────────────────────────
GITHUB_TOKEN=your_github_personal_access_token_here

# ── Ollama (local model) ───────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=hermes3                  # or mistral, llama3, etc.

# ── Model selection ────────────────────────────────────────────
DEFAULT_MODEL=claude                  # claude | ollama
CLAUDE_MODEL=claude-sonnet-4-6

# ── Logging ────────────────────────────────────────────────────
LOG_LEVEL=INFO
